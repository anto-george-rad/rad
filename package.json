{
  "name": "rad-workspace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/manrope": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "bcryptjs": "2.4.3",
    "chart.js": "4.4.4",
    "clsx": "2.1.1",
    "drizzle-orm": "0.33.0",
    "imapflow": "^1.0.164",
    "jose": "5.9.3",
    "lucide-react": "0.441.0",
    "mailparser": "^3.7.1",
    "next": "14.2.35",
    "nodemailer": "6.9.15",
    "papaparse": "5.4.1",
    "postgres": "3.4.4",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-chartjs-2": "5.2.0",
    "react-dom": "18.3.1",
    "server-only": "0.0.1",
    "zod": "3.23.8"
