    "@types/node": "20.16.10",
    "@types/nodemailer": "6.4.16",
    "@types/papaparse": "5.3.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.24.2",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.2"
  }
