# PostgreSQL connection
DATABASE_URL=postgres://crm:crm@localhost:5432/raidefend
# Long random string used to sign login sessions (openssl rand -base64 48). The app refuses to start in production without it.
AUTH_SECRET=change-me-to-a-long-random-string
# First admin account created by `npm run setup`
ADMIN_EMAIL=admin@raidefend.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin
# Address people use to open RAD Workspace (used in reset emails, ticket emails, portal invites and rating links)
APP_URL=http://localhost:3000
# Company time zone for "today", due dates and the hourly jobs
APP_TIMEZONE=Asia/Dubai
# Outgoing email (SMTP): password resets, ticket replies to customers, acknowledgements, portal invites.
# Without it, the helpdesk still works but customers only see replies in the portal; admins create reset links in Settings → Users.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Helpdesk: support address for the default “Support” department created at setup (each department's own address and
# IMAP mailbox are set in Settings → Departments & teams; mailboxes are checked every 2 minutes)
SUPPORT_EMAIL=
# Where uploaded files are stored (a Docker volume in production)
UPLOAD_DIR=./uploads
# Optional: lets an outside scheduler call /api/cron with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Optional: enables AI (deal summaries, email drafts, helpdesk suggested replies, summaries, auto-triage, sentiment alerts).
# Outlook sync and WhatsApp credentials are entered in Settings (stored encrypted), not here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to "true" to load example records during setup
SEED_SAMPLE_DATA=true
# Set to "true" only when serving over plain HTTP (e.g. local network without TLS)
INSECURE_COOKIES=false
# Database password used by docker compose, and how many days of daily backups to keep
DB_PASSWORD=crm
BACKUP_KEEP_DAYS=14
